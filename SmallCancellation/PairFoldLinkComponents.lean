import SmallCancellation.PairFoldCellLink
import SmallCancellation.PairingComponents

namespace GreendlingerDehn

/-- The cyclic polygon-corner involution, viewed as a total pairing of the
face-endpoint germs at one quotient vertex. -/
noncomputable def MinimalAreaRelatorBoundarySeed.pairFoldCornerPairingAtVertex
    {α : Type*} [Fintype α] [DecidableEq α]
    {P : SymmetrizedPresentation α} {w : FreeGroup α}
    (seed : MinimalAreaRelatorBoundarySeed P.relators w) (hne : w ≠ 1)
    {v : seed.pairFoldFiniteGraph.toDartGraph.Vertex} :
    PartialOccurrencePairing (seed.PairFoldFaceGermsAtVertex hne v) where
  partner a := some (seed.pairFoldFaceCornerMateAtVertex hne a)
  partner_symm := by
    intro a b hab
    have hb : seed.pairFoldFaceCornerMateAtVertex hne a = b :=
      Option.some.inj hab
    subst b
    simpa using seed.pairFoldFaceCornerMateAtVertex_involutive hne a
  partner_ne := by
    intro a hself
    have heq : seed.pairFoldFaceCornerMateAtVertex hne a = a :=
      Option.some.inj hself
    exact seed.pairFoldFaceCornerMateAtVertex_ne hne a heq

/-- Crossing a folded edge is a partial pairing on face-endpoint germs; the
unpaired germs are precisely the ends exposed to the boundary. -/
noncomputable def MinimalAreaRelatorBoundarySeed.pairFoldEdgePairingAtVertex
    {α : Type*} [Fintype α] [DecidableEq α]
    {P : SymmetrizedPresentation α} {w : FreeGroup α}
    (seed : MinimalAreaRelatorBoundarySeed P.relators w) (hne : w ≠ 1)
    {v : seed.pairFoldFiniteGraph.toDartGraph.Vertex} :
    PartialOccurrencePairing (seed.PairFoldFaceGermsAtVertex hne v) where
  partner := seed.pairFoldFaceEdgeMateAtVertex? hne
  partner_symm := by
    intro a b hab
    exact seed.pairFoldFaceEdgeMateAtVertex?_involutive hne a b hab
  partner_ne := by
    intro a hself
    have hstep := seed.pairFoldFaceEdgeMateAtVertex?_spec hne a a hself
    exact hstep.2 rfl

/-- The flag graph of corners and shared-edge crossings is exactly the graph
generated by these two pairings. -/
theorem MinimalAreaRelatorBoundarySeed.pairFoldFaceLinkGraph_eq_pairingGraph
    {α : Type*} [Fintype α] [DecidableEq α]
    {P : SymmetrizedPresentation α} {w : FreeGroup α}
    (seed : MinimalAreaRelatorBoundarySeed P.relators w) (hne : w ≠ 1)
    {v : seed.pairFoldFiniteGraph.toDartGraph.Vertex} :
    seed.pairFoldFaceLinkGraph hne v =
      twoPairingGraph (seed.pairFoldCornerPairingAtVertex hne)
        (seed.pairFoldEdgePairingAtVertex hne) := by
  classical
  ext a b
  rw [seed.pairFoldFaceLinkGraph_adj_iff hne v a b]
  simp only [twoPairingGraph, MinimalAreaRelatorBoundarySeed.pairFoldCornerPairingAtVertex,
    MinimalAreaRelatorBoundarySeed.pairFoldEdgePairingAtVertex,
    PartialOccurrencePairing.partner, Option.some.injEq]
  constructor
  · rintro (hcorner | hedge)
    · exact Or.inl hcorner
    · exact Or.inr
        (seed.pairFoldFaceEdgeMateAtVertex?_of_edgeStep hne a b hedge)
  · rintro (hcorner | hedge)
    · exact Or.inl hcorner
    · exact Or.inr
        (seed.pairFoldFaceEdgeMateAtVertex?_spec hne a b hedge)

/-- In each connected component of the face-germ link, the across-edge
pairing has either zero or two unmatched germs. The corner pairing is total,
so these are exactly the closed-cycle and exposed-path cases. -/
theorem MinimalAreaRelatorBoundarySeed.pairFoldFaceLinkComponent_boundary_count_zero_or_two
    {α : Type*} [Fintype α] [DecidableEq α]
    {P : SymmetrizedPresentation α} {w : FreeGroup α}
    (seed : MinimalAreaRelatorBoundarySeed P.relators w) (hne : w ≠ 1)
    {v : seed.pairFoldFiniteGraph.toDartGraph.Vertex}
    (C : (twoPairingGraph (seed.pairFoldCornerPairingAtVertex hne (v := v))
      (seed.pairFoldEdgePairingAtVertex hne (v := v))).ConnectedComponent) :
    Nat.card {germ : C.supp //
        (componentRightPairing (seed.pairFoldCornerPairingAtVertex hne (v := v))
          (seed.pairFoldEdgePairingAtVertex hne (v := v)) C).partner germ = none} = 0 ∨
      Nat.card {germ : C.supp //
        (componentRightPairing (seed.pairFoldCornerPairingAtVertex hne (v := v))
          (seed.pairFoldEdgePairingAtVertex hne (v := v)) C).partner germ = none} = 2 := by
  classical
  let cornerPairing := seed.pairFoldCornerPairingAtVertex hne (v := v)
  let edgePairing := seed.pairFoldEdgePairingAtVertex hne (v := v)
  let cornerOnComponent := componentLeftPairing cornerPairing edgePairing C
  let edgeOnComponent := componentRightPairing cornerPairing edgePairing C
  letI : Fintype C.supp := Fintype.ofFinite _
  letI : DecidableEq C.supp := Classical.decEq _
  have hconn :
      (twoPairingGraph cornerOnComponent edgeOnComponent).Connected := by
    rw [twoPairingGraph_component_eq_induce cornerPairing edgePairing C]
    exact C.connected_toSimpleGraph
  have hslots := card_unpaired_pairing_slots_eq_zero_or_two_of_connected
    cornerOnComponent edgeOnComponent hconn
  let cornerUnmatched := {germ : C.supp // cornerOnComponent.partner germ = none}
  let edgeUnmatched := {germ : C.supp // edgeOnComponent.partner germ = none}
  have hcornerEmpty : IsEmpty cornerUnmatched := by
    refine ⟨?_⟩
    rintro ⟨germ, hnone⟩
    have hglobal :=
      (componentLeftPairing_partner_none_iff cornerPairing edgePairing C germ).mp
        hnone
    simp [cornerPairing, MinimalAreaRelatorBoundarySeed.pairFoldCornerPairingAtVertex]
      at hglobal
  letI : IsEmpty cornerUnmatched := hcornerEmpty
  have hcard : Nat.card (cornerUnmatched ⊕ edgeUnmatched) =
      Nat.card edgeUnmatched := by
    simp [cornerUnmatched, edgeUnmatched]
  rcases hslots with hzero | htwo
  · left
    calc
      Nat.card edgeUnmatched = Nat.card (cornerUnmatched ⊕ edgeUnmatched) :=
        hcard.symm
      _ = 0 := hzero
  · right
    calc
      Nat.card edgeUnmatched = Nat.card (cornerUnmatched ⊕ edgeUnmatched) :=
        hcard.symm
      _ = 2 := htwo

end GreendlingerDehn
